// SmartShift Swap – Erweiterung des GastroEvolution-Schemas (PostgreSQL).
// `Restaurant` und `User` existieren im Bestandssystem; hier nur die für SmartShift relevanten Felder.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Skill {
  BAR
  SERVICE
  KITCHEN
  DISHWASHING
}

enum ShiftStatus {
  OPEN
  MATCHED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED // nach der Zusage abgesagt
}

enum CancelledBy {
  FREELANCER
  RESTAURANT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum OtpChannel {
  EMAIL
  SMS
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id          String             @id @default(uuid())
  email       String             @unique
  /// scrypt-Hash; leer für Nutzer, die sich über das bestehende GastroEvolution-Login anmelden
  passwordHash String?
  /// Handynummer im E.164-Format – Kontaktdatum, wird NICHT per SMS geprüft (daher nicht eindeutig)
  phone           String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  /// Authenticator-App (TOTP, RFC 6238): Secret AES-256-GCM verschlüsselt; aktiv erst nach Bestätigung mit einem Code
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  /// letzter akzeptierter 30-Sekunden-Schritt → ein Code ist nur einmal nutzbar (Replay-Schutz)
  totpLastStep    Int?
  totpFailures    Int       @default(0)
  totpLockedUntil DateTime?
  /// Sperre nach zu vielen falschen Passwörtern
  passwordFailures    Int       @default(0)
  passwordLockedUntil DateTime?
  /// Sitzungen, die vor diesem Zeitpunkt ausgestellt wurden, sind ungültig (Passwort-Reset, Kontolöschung)
  sessionsValidFrom   DateTime?
  otpChallenges   OtpChallenge[]
  pushSubscriptions PushSubscription[]
  /// Verwaltungsrechte (nur per scripts/admin.ts vergeben)
  isAdmin         Boolean   @default(false)
  /// Gesetzt bei Löschung/Anonymisierung des Kontos
  deletedAt       DateTime?
  /// Zustimmung zu Nutzungsbedingungen/Datenschutz (Zeitpunkt und Version der Texte)
  termsAcceptedAt DateTime?
  termsVersion    String?
  memberships RestaurantMember[]
  freelancer  Freelancer?
}

model Restaurant {
  id        String @id @default(uuid())
  name      String
  street    String
  zip       String
  city      String
  latitude  Float // WGS84
  longitude Float
  /// 8-stellige Betriebsnummer des Arbeitgebers (Pflicht für die DEÜV-Sofortmeldung)
  employerBetriebsnummer String?
  /// Gesperrte Betriebe können keine Schichten ausschreiben (Missbrauchsschutz, durch Verwaltung gesetzt)
  blockedAt DateTime?
  apiKeys   RestaurantApiKey[]
  invitations TeamInvitation[]

  members        RestaurantMember[]
  shifts         MarketplaceShift[]
  tempEmployees  TemporaryEmployee[]
}

/// Zugriffsrecht eines Users auf ein Restaurant (Grundlage aller Wirt-Autorisierungen).
model RestaurantMember {
  userId       String
  restaurantId String
  role         MemberRole
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

model MarketplaceShift {
  id            String      @id @default(uuid())
  restaurantId  String
  role          String // Anzeigename, z. B. "Barkeeper"
  requiredSkill Skill
  requirements  String?
  /// 9-stelliger Tätigkeitsschlüssel (Schlüsselverzeichnis der BA) für die Sofortmeldung
  activityKey   String?
  hourlyRateCents Int
  startTime     DateTime
  endTime       DateTime
  // Denormalisiert vom Restaurant zum Erstellzeitpunkt → Geo-Suche ohne Join-Zwang, Index nutzbar
  latitude      Float
  longitude     Float
  status        ShiftStatus @default(OPEN)
  /// Bewertung (1–5) der Aushilfe durch den Wirt beim Abschluss
  rating        Int?
  /// Mehrere Personen gesucht: zusammengehörige Stellen teilen eine groupId; für Aushilfen erscheint nur die erste freie Stelle
  groupId       String?
  slotIndex     Int         @default(1)
  slotCount     Int         @default(1)
  /// Optimistic-Locking-Zähler gegen Doppel-Zusagen
  version       Int         @default(0)
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  applications ShiftApplication[]
  assignment   TemporaryEmployee?

  @@index([status, latitude, longitude]) // Bounding-Box-Vorfilter der Umkreissuche
  @@index([restaurantId, status])
  @@index([startTime])
  @@index([groupId])
}

model Freelancer {
  id             String   @id @default(uuid())
  userId         String   @unique
  displayName    String
  /// Nur durch Admin/Verifizierungsprozess gesetzte Fähigkeiten
  verifiedSkills Skill[]
  /// Vom Nutzer angegebene Fähigkeiten – werden erst durch die Verifizierung zu verifiedSkills
  claimedSkills  Skill[]  @default([])
  /// Zeitpunkt der Datenschutz-Einwilligung (Nachweis)
  privacyConsentAt DateTime?
  verified       Boolean  @default(false)
  ratingSum      Int      @default(0)
  ratingCount    Int      @default(0)
  // Wohnort/Standardstandort für die Suche
  homeLatitude   Float?
  homeLongitude  Float?
  // ---- Compliance-Pflichtfelder (NOT NULL) – AES-256-GCM verschlüsselt, nie in API-Antworten ----
  socialSecurityNumberEnc String   @map("social_security_number")
  taxIdEnc                String   @map("tax_id")
  birthDate               DateTime @map("birth_date") @db.Date
  /// Gesetzt erst nach erfolgreicher Formal-/Prüfziffernvalidierung (services/compliance.ts).
  /// Ohne diesen Zeitstempel ist keine Bewerbung möglich.
  complianceValidatedAt   DateTime?
  // ---- Zuverlässigkeit / Sperrlogik (services/reliability.ts) ----
  reliabilityScore Float         @default(1.0) @map("reliability_score")
  accountStatus    AccountStatus @default(ACTIVE)
  suspendedUntil   DateTime?
  noShowCount      Int           @default(0)
  /// Absagen weniger als 24 h vor Schichtbeginn
  lateCancelCount  Int           @default(0)
  createdAt      DateTime @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications  ShiftApplication[]
  tempEmployees TemporaryEmployee[]
  hygieneCertificate HygieneCertificate?
}

/// Nachweis der Belehrung nach § 43 Infektionsschutzgesetz (Foto/PDF), AES-256-GCM verschlüsselt.
/// Wirte sehen vorab nur „vorhanden + Ausstellungsdatum“; das Dokument erst nach der Zusage (Nachweispflicht des Arbeitgebers).
model HygieneCertificate {
  id           String     @id @default(uuid())
  freelancerId String     @unique
  mimeType     String
  dataEnc      Bytes
  issuedOn     DateTime   @db.Date
  uploadedAt   DateTime   @default(now())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model ShiftApplication {
  id           String            @id @default(uuid())
  shiftId      String
  freelancerId String
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  shift      MarketplaceShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  freelancer Freelancer       @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([shiftId, freelancerId]) // Idempotentes Swipen
  @@index([freelancerId, status])
}

// ---- Integrations-Ziel: Dienstplan / Zeiterfassung / Sofortmeldung ------------------------------
// Im Bestandssystem ersetzt der Adapter in integrations/timeTracking.ts diese Tabellen durch
// die echten Dienstplan-/Zeiterfassungs-Services.

model TemporaryEmployee {
  id           String   @id @default(uuid())
  restaurantId String
  freelancerId String
  shiftId      String   @unique // 1:1 → Trigger ist idempotent
  validFrom    DateTime
  validUntil   DateTime // Profil läuft automatisch nach der Schicht ab
  /// Terminal-PIN für das Einchecken (nur Hash speichern)
  clockInPinHash String?
  /// vom Zeiterfassungsterminal gesetzt
  clockedInAt    DateTime?
  /// gesetzt, sobald ein No-Show registriert wurde (Idempotenz)
  noShowRecordedAt DateTime?
  /// Erinnerung an den Wirt („Ist die Aushilfe erschienen?“) wurde gesendet
  attendanceReminderAt DateTime?

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  freelancer Freelancer       @relation(fields: [freelancerId], references: [id])
  shift      MarketplaceShift @relation(fields: [shiftId], references: [id])
  rosterEntry RosterEntry?
  immediateNotification ImmediateNotification?

  @@index([restaurantId, validFrom])
}

model RosterEntry {
  id                  String   @id @default(uuid())
  restaurantId        String
  temporaryEmployeeId String   @unique
  role                String
  startTime           DateTime
  endTime             DateTime
  hourlyRateCents     Int

  temporaryEmployee TemporaryEmployee @relation(fields: [temporaryEmployeeId], references: [id])

  @@index([restaurantId, startTime])
}

enum NotificationStatus {
  NEEDS_DATA // Pflichtangaben fehlen (z. B. Betriebsnummer)
  READY
  SENT
  FAILED
}

/// Datensatz für die gesetzliche Sofortmeldung (§ 28a SGB IV); Übermittlung erfolgt asynchron (Worker).
model ImmediateNotification {
  id                  String             @id @default(uuid())
  temporaryEmployeeId String             @unique
  payloadEnc          String // verschlüsselter JSON-Payload inkl. SV-Nummer
  status              NotificationStatus @default(READY)
  missingFields       String[]
  /// Vom Betrieb als „bei der Sozialversicherung gemeldet“ markiert
  reportedAt          DateTime?
  /// Optional: Bestätigungs-/Referenznummer der Meldung
  reference           String?
  reminderSentAt      DateTime?
  createdAt           DateTime           @default(now())

  temporaryEmployee TemporaryEmployee @relation(fields: [temporaryEmployeeId], references: [id])
}

/// Transactional Outbox: Events werden in derselben Transaktion wie die Fachänderung geschrieben
/// und danach zuverlässig (mit Retry) an Webhook-Empfänger zugestellt.
model WebhookEvent {
  id          String    @id @default(uuid())
  type        String // z. B. trigger_sofortmeldung_generation
  payload     Json // enthält nur IDs – keine Personendaten
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, createdAt])
}

/// Einmalcodes für Kontobestätigung und Zwei-Faktor-Anmeldung. Codes werden nur als HMAC gespeichert.
model OtpChallenge {
  id         String     @id
  userId     String
  purpose    OtpPurpose
  channel    OtpChannel
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, channel, createdAt])
}

/// API-Schlüssel eines Betriebs für das Zeiterfassungsterminal / Dienstplan-System (nur der SHA-256-Hash wird gespeichert).
model RestaurantApiKey {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  prefix       String // die ersten Zeichen zur Wiedererkennung in der Liste
  keyHash      String     @unique
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Nachvollziehbarkeit sensibler Verwaltungsaktionen (Sperren, Dokumenteinsicht, Löschung).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Absagen nach der Zusage (durch Aushilfe oder Betrieb) – Nachweis und Auswertung; bewusst ohne Fremdschlüssel.
model ShiftCancellation {
  id                    String      @id @default(uuid())
  shiftId               String
  freelancerId          String
  cancelledBy           CancelledBy
  hoursBeforeStart      Float
  late                  Boolean
  reason                String?
  sofortmeldungReported Boolean
  createdAt             DateTime    @default(now())

  @@index([shiftId])
  @@index([freelancerId, createdAt])
}

/// Einladung eines Mitarbeiters (Rolle Manager) in einen Betrieb. Der Token steht nur in der E-Mail; gespeichert wird sein Hash.
model TeamInvitation {
  id           String     @id @default(uuid())
  restaurantId String
  email        String
  role         MemberRole @default(MANAGER)
  tokenHash    String     @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Web-Push-Abonnement eines Geräts/Browsers (VAPID). Ungültige Abonnements werden beim Versand automatisch entfernt.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
