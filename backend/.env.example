DATABASE_URL=postgresql://gastro:gastro@localhost:5432/gastroevolution
JWT_SECRET=change-me-min-32-chars-long-secret-value
# 32 Byte, base64: openssl rand -base64 32
SSN_ENCRYPTION_KEY=
PORT=3000

# --- Bestätigungscodes / Zwei-Faktor-Anmeldung ---
# live = echter Versand (Standard in Produktion, benötigt SMTP und SMS-Zugang unten)
# log  = Codes nur ins Server-Protokoll (NUR zum Testen – wer das Protokoll liest, sieht alle Codes)
NOTIFY_MODE=live
# E-Mail (SMTP), z. B. Strato: smtp.strato.de, Port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GastroEvolution <no-reply@gastroevolution.de>"
# SMS über Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
